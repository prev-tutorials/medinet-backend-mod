<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackAsTool>true</PackAsTool>
    <ToolCommandName>feature</ToolCommandName>
    <PackageId>Medinet.Feature.Cli</PackageId>
    <Version>1.0.0</Version>
    <Authors>Medinet</Authors>
    <Description>Generador de slices para Medinet.</Description>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Templates/**/*.tpl" WithCulture="false" />
  </ItemGroup>

</Project>
